# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# JWT authentication
JWT_SECRET=replace-with-a-long-random-secret

# Google OAuth (Web & Mobile Flutter)
GOOGLE_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=replace-with-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=replace-with-ios-client-id.apps.googleusercontent.com

# HiveMQ Cloud
MQTT_BROKER_URL=mqtts://your-cluster.hivemq.cloud:8883
MQTT_USERNAME=your-hivemq-username
MQTT_PASSWORD=your-hivemq-password
# Topic dibuat oleh backend: devices/{serial}/data dan devices/{serial}/command
